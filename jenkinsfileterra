pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION    = 'us-east-1'
    }

    stages {

        stage('SCM') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/karanmalhotr-a11y/Terraformkm.git'
            }
        }

      stage('Docker Build & Push') {
            steps {
                withCredentials([
                    string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER'),
                    string(credentialsId: 'DOCKER_PASS', variable: 'DOCKER_PASS')
                ]) {
                    sh '''
                        export PATH=$PATH:/usr/local/bin
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker build -t "$DOCKER_USER/kmjenkins:terrakm" .
                        docker push "$DOCKER_USER/kmjenkins:terrakm"
                    '''
                }
            }
        }

        // ── Stage 4: Terraform Init ────────────────────────────────
        // Runs INSIDE the Docker container built above.
        // docker run mounts the workspace so Terraform can read .tf files
        // and write the .terraform directory + tfplan back to the Jenkins
        // workspace (shared via the -v volume mount).
        stage('Terraform Init') {
            steps {
                sh """
                    docker run --rm \
                        -v ${WORKSPACE}:/workspace \
                        -w /workspace \
                        -e AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
                        -e AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
                        -e AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION} \
                        ${FULL_IMAGE} init
                """
            }
        }

        // ── Stage 5: Terraform Validate ───────────────────────────
        stage('Terraform Validate') {
            steps {
                sh """
                    docker run --rm \
                        -v ${WORKSPACE}:/workspace \
                        -w /workspace \
                        -e AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
                        -e AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
                        -e AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION} \
                        ${FULL_IMAGE} validate
                """
            }
        }

        // ── Stage 6: Terraform Plan ────────────────────────────────
        // Saves the plan to /workspace/tfplan inside the container,
        // which maps to ${WORKSPACE}/tfplan on the Jenkins agent —
        // so the Apply stage can pick it up in a fresh container run.
        stage('Terraform Plan') {
            steps {
                sh """
                    docker run --rm \
                        -v ${WORKSPACE}:/workspace \
                        -w /workspace \
                        -e AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
                        -e AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
                        -e AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION} \
                        ${FULL_IMAGE} plan -out=/workspace/tfplan
                """
            }
        }

        // ── Stage 7: Approval gate (main branch only) ──────────────
        stage('Approval') {
            when {
                branch 'main'
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Apply Terraform changes to AWS?', ok: 'Apply'
                }
            }
        }

        // ── Stage 8: Terraform Apply ───────────────────────────────
        // Picks up the tfplan file written by the Plan stage.
        // Runs inside the same Docker image — guaranteed same Terraform
        // version and provider versions as Plan.
        stage('Terraform Apply') {
            steps {
                sh """
                    docker run --rm \
                        -v ${WORKSPACE}:/workspace \
                        -w /workspace \
                        -e AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
                        -e AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
                        -e AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION} \
                        ${FULL_IMAGE} apply -auto-approve /workspace/tfplan
                """
            }
        }

        // ── Stage 9: Terraform Destroy (commented out by default) ──
        // Uncomment only when you intentionally want to destroy infra.
        // stage('Terraform Destroy') {
        //     steps {
        //         input message: 'Are you sure you want to DESTROY all infrastructure?'
        //         sh """
        //             docker run --rm \
        //                 -v ${WORKSPACE}:/workspace \
        //                 -w /workspace \
        //                 -e AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
        //                 -e AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
        //                 -e AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION} \
        //                 ${FULL_IMAGE} destroy -auto-approve
        //         """
        //     }
        // }
    }

    post {
        success {
            echo "Pipeline succeeded — image pushed as ${FULL_IMAGE}"
        }
        failure {
            echo 'Pipeline failed — check logs above.'
            sh 'docker image prune -f || true'
        }
        always {
            // Remove local image after pipeline — it is safely in the registry
            sh """
                docker rmi ${FULL_IMAGE} ${FULL_IMAGE_LATEST} || true
            """
        }
    }
