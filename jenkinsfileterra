pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION    = 'us-east-1'
    }

    stages {

        stage('SCM') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/karanmalhotr-a11y/Terraformkm.git'
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([
                    string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER'),
                    string(credentialsId: 'DOCKER_PASS', variable: 'DOCKER_PASS')
                ]) {
                    sh '''
                        export PATH=$PATH:/usr/local/bin
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker build -t "$DOCKER_USER/kmjenkins:terrakm" .
                        docker push "$DOCKER_USER/kmjenkins:terrakm"
                        docker logout
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER')
                ]) {
                    sh """
                        docker run --rm \
                            -v "\${WORKSPACE}:/workspace" \
                            -w /workspace \
                            -e AWS_ACCESS_KEY_ID="\${AWS_ACCESS_KEY_ID}" \
                            -e AWS_SECRET_ACCESS_KEY="\${AWS_SECRET_ACCESS_KEY}" \
                            -e AWS_DEFAULT_REGION="\${AWS_DEFAULT_REGION}" \
                            "\${DOCKER_USER}/kmjenkins:terrakm" init -input=false
                    """
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                withCredentials([
                    string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER')
                ]) {
                    sh """
                        docker run --rm \
                            -v "\${WORKSPACE}:/workspace" \
                            -w /workspace \
                            -e AWS_ACCESS_KEY_ID="\${AWS_ACCESS_KEY_ID}" \
                            -e AWS_SECRET_ACCESS_KEY="\${AWS_SECRET_ACCESS_KEY}" \
                            -e AWS_DEFAULT_REGION="\${AWS_DEFAULT_REGION}" \
                            "\${DOCKER_USER}/kmjenkins:terrakm" validate
                    """
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER')
                ]) {
                    sh """
                        docker run --rm \
                            -v "\${WORKSPACE}:/workspace" \
                            -w /workspace \
                            -e AWS_ACCESS_KEY_ID="\${AWS_ACCESS_KEY_ID}" \
                            -e AWS_SECRET_ACCESS_KEY="\${AWS_SECRET_ACCESS_KEY}" \
                            -e AWS_DEFAULT_REGION="\${AWS_DEFAULT_REGION}" \
                            "\${DOCKER_USER}/kmjenkins:terrakm" plan -input=false -out=/workspace/tfplan
                    """
                }
            }
        }

        stage('Approval') {
            when {
                branch 'main'
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    input message: 'Apply Terraform changes to AWS?', ok: 'Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([
                    string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER')
                ]) {
                    sh """
                        docker run --rm \
                            -v "\${WORKSPACE}:/workspace" \
                            -w /workspace \
                            -e AWS_ACCESS_KEY_ID="\${AWS_ACCESS_KEY_ID}" \
                            -e AWS_SECRET_ACCESS_KEY="\${AWS_SECRET_ACCESS_KEY}" \
                            -e AWS_DEFAULT_REGION="\${AWS_DEFAULT_REGION}" \
                            "\${DOCKER_USER}/kmjenkins:terrakm" apply -auto-approve /workspace/tfplan
                    """
                }
            }
        }

        // stage('Terraform Destroy') {
        //     steps {
        //         input message: 'Are you sure you want to DESTROY all infrastructure?'
        //         withCredentials([string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER')]) {
        //             sh """
        //                 docker run --rm \
        //                     -v "\${WORKSPACE}:/workspace" \
        //                     -w /workspace \
        //                     -e AWS_ACCESS_KEY_ID="\${AWS_ACCESS_KEY_ID}" \
        //                     -e AWS_SECRET_ACCESS_KEY="\${AWS_SECRET_ACCESS_KEY}" \
        //                     -e AWS_DEFAULT_REGION="\${AWS_DEFAULT_REGION}" \
        //                     "\${DOCKER_USER}/kmjenkins:terrakm" destroy -auto-approve
        //             """
        //         }
        //     }
        // }
    }

    post {
        success {
            echo 'Pipeline succeeded.'
        }
        failure {
            echo 'Pipeline failed — check logs above.'
            sh 'docker image prune -f || true'
        }
        always {
            withCredentials([string(credentialsId: 'DOCKER_USER', variable: 'DOCKER_USER')]) {
                sh 'docker rmi "$DOCKER_USER/kmjenkins:terrakm" || true'
            }
        }
    }
}
